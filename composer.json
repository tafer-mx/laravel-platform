{
    "name": "tafer-mx/laravel-platform",
    "description": "Shared logic for Tafer Laravel projects",
    "type": "library",
    "license": "proprietary",
    "scripts": {
        "test": "pest",
        "test:unit": "pest tests/Unit"
    },
    "autoload": {
        "psr-4": {
            "TAFER\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.7"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    }
}
